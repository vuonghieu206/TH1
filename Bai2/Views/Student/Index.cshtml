@model IEnumerable<THLab1.Models.Student>
@using THLab1.Models
@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
<div class="card"><div class="card-header"><h3 class="card-title">Danh sách sinh viên</h3><div class="card-tools"><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Create Student</a></div></div>
<div class="card-body table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Mã</th><th>Họ tên</th><th>Ngày sinh</th><th>Ngành</th><th>Giới tính</th><th>Hệ ĐT</th><th>Địa chỉ</th><th>Email</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.Id</td><td>@s.Name</td><td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td><td>@(s.Branch switch { Branch.IT => "CNTT", Branch.BE => "Kinh tế", Branch.CE => "Công trình", Branch.EE => "Điện - Điện tử", _ => "" })</td><td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td><td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td><td>@s.Address</td><td>@s.Email</td></tr> }
</tbody></table></div></div>
@section Scripts {
<script>
  const table = document.querySelector("table");
  if (table) { table.addEventListener("click", function () { table.classList.toggle("table-warning"); }); }
</script>
}
